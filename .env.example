# Runtime-only configuration. Replace placeholders; do not store credentials.
KNOWLEDGE_API_HOST=0.0.0.0
KNOWLEDGE_API_ENV=production
# PORT is assigned by the PaaS; optional KNOWLEDGE_API_PORT overrides it.
KNOWLEDGE_API_CATALOG_PATH=/app/data/document-catalog.json
KNOWLEDGE_API_AUTH_ISSUER=https://solo-web.example
KNOWLEDGE_API_AUTH_PUBLIC_KEY=REPLACE_WITH_PEM_RSA_PUBLIC_KEY
KNOWLEDGE_API_AUTH_SUBJECTS=REPLACE_WITH_ALLOWED_OIDC_OWNER_SUBJECT
KNOWLEDGE_API_CORS_ORIGINS=https://solo-web.example
